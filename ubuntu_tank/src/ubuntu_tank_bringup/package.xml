<?xml version="1.0"?>
<!--
Declare the ubuntu_tank_bringup ROS package metadata and build/runtime dependencies.
-->
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ubuntu_tank_bringup</name>
  <version>1.0.0</version>
  <description>Guarded launch and bringup integration for Ubuntu Tank native controller</description>
  <maintainer email="dev@mentorpi.local">Ubuntu Tank Maintainers</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ros_robot_controller_msgs</exec_depend>
  <exec_depend>ros_robot_controller</exec_depend>
  <exec_depend>controller</exec_depend>
  <exec_depend>ubuntu_tank_safety</exec_depend>
  <exec_depend>ubuntu_tank_supervisor</exec_depend>
  <exec_depend>ubuntu_tank_teleop</exec_depend>
  <exec_depend>ubuntu_tank_operator</exec_depend>
  <exec_depend>python3-yaml</exec_depend>


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
