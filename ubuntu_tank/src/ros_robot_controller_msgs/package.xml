<?xml version="1.0"?>
<!--
Declare the ros_robot_controller_msgs ROS package metadata and build/runtime
dependencies.
Adapted from Hiwonder MentorPi:
mentorpi/src/driver/ros_robot_controller_msgs/package.xml.
Local adaptations: Update package version to 1.0.0, description, maintainer
dev@mentorpi.local, and Apache-2.0 license declaration.
-->
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros_robot_controller_msgs</name>
  <version>1.0.0</version>
  <description>MentorPi robot controller message and service interface definitions</description>
  <maintainer email="dev@mentorpi.local">Ubuntu Tank Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <depend>std_msgs</depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
