<?xml version="1.0"?>
<!--
Declare the ubuntu_tank_web ROS package metadata and build/runtime dependencies.
-->
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ubuntu_tank_web</name>
  <version>1.0.0</version>
  <description>FastAPI Web Control API and Uvicorn Server for MentorPi Pi 5</description>
  <maintainer email="dev@mentorpi.local">Ubuntu Tank Maintainers</maintainer>
  <license>Apache-2.0</license>

  <depend>ubuntu_tank_operator</depend>
  <depend>python3-fastapi</depend>
  <depend>python3-uvicorn</depend>
  <depend>python3-pydantic</depend>
  <depend>python3-websockets</depend>
  <depend>python3-cryptography</depend>
  <depend>python3-yaml</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
