<?xml version="1.0"?>
<!--
Declare the ubuntu_tank_teleop ROS package metadata and build/runtime dependencies.
-->
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ubuntu_tank_teleop</name>
  <version>1.0.0</version>
  <description>Safe keyboard teleoperation with renewable motion leases and fail-closed zeroing</description>
  <maintainer email="dev@mentorpi.local">Ubuntu Tank Maintainers</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>ubuntu_tank_operator</depend>


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>ubuntu_tank_protocol</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
