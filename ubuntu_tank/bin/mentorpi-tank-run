#!/usr/bin/env python3
"""
mentorpi-tank-run - Non-interactive ROS launch and supervisor wrapper for systemd.

Invoked by mentorpi-tank.service (ExecStart=/opt/ubuntu_tank/current/bin/mentorpi-tank-run).
Runs only installed artifacts from /opt/ubuntu_tank/current/install.
Runs the supervisor in the main process (satisfying NotifyAccess=main),
applies preserved host configuration from UBUNTU_TANK_CONFIG to the ROS graph,
launches the ROS bringup graph (tank.launch.py) as a supervised child process,
notifies systemd (READY=1, WATCHDOG=1), coordinates safe disarmed shutdown on SIGTERM/SIGINT,
and propagates unexpected child termination as a supervisor failure.
"""

import argparse
import fcntl
import json
import math
import os
import select
import signal
import socket
import struct
import subprocess
import sys
import time
from typing import Any, Dict, List, Optional, Tuple
import yaml

# Import configuration validation helper
bin_dir = os.path.dirname(os.path.abspath(__file__))
for cand in [
    os.path.join(bin_dir, "..", "scripts"),
    os.path.join(bin_dir, "..", "libexec"),
]:
    if os.path.isdir(cand) and cand not in sys.path:
        sys.path.insert(0, cand)

try:
    from config_migration import validate_config
except ImportError:
    try:
        from ubuntu_tank.scripts.config_migration import validate_config
    except ImportError:
        validate_config = None

try:
    from deployment_manager import check_hardware_mutual_exclusion
except ImportError:
    try:
        from ubuntu_tank.scripts.deployment_manager import (
            check_hardware_mutual_exclusion,
        )
    except ImportError:
        check_hardware_mutual_exclusion = None

try:
    from fastdds_setup import apply_loopback_env, validate_loopback_profile
except ImportError:
    try:
        from ubuntu_tank.scripts.fastdds_setup import (
            apply_loopback_env,
            validate_loopback_profile,
        )
    except ImportError:
        apply_loopback_env = None
        validate_loopback_profile = None


def parse_env_file(filepath: str) -> Dict[str, str]:
    """Parse key-value environment variables from an env file."""
    env = {}
    if not os.path.isfile(filepath):
        return env
    try:
        with open(filepath, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" in line:
                    k, v = line.split("=", 1)
                    k = k.strip()
                    v = v.strip().strip("'\"")
                    env[k] = v
    except Exception as e:
        sys.stderr.write(
            f"[mentorpi-tank-run] Warning: failed to read {filepath}: {e}\n"
        )
    return env


def source_bash_environment(script_paths: List[str]) -> Dict[str, str]:
    """Source bash setup scripts and extract exported environment variables."""
    existing_scripts = [p for p in script_paths if os.path.isfile(p)]
    if not existing_scripts:
        return {}
    cmd_parts = []
    for s in existing_scripts:
        cmd_parts.append(f'. "{s}" >/dev/null 2>&1')
    cmd_parts.append(
        "python3 -c 'import os, json; print(json.dumps(dict(os.environ)))'"
    )
    full_cmd = " && ".join(cmd_parts)
    try:
        out = subprocess.check_output(["bash", "-c", full_cmd], text=True, timeout=10.0)
        return json.loads(out)
    except Exception as e:
        sys.stderr.write(
            f"[mentorpi-tank-run] Warning: failed to source bash environments: {e}\n"
        )
        return {}


def extract_credentials(ancdata) -> Tuple[Optional[int], Optional[int], Optional[int]]:
    """Extract peer (pid, uid, gid) from SCM_CREDENTIALS ancillary data."""
    for cmsg_level, cmsg_type, cmsg_data in ancdata:
        if cmsg_level == socket.SOL_SOCKET and cmsg_type == socket.SCM_CREDENTIALS:
            if len(cmsg_data) >= 12:
                pid, uid, gid = struct.unpack("iii", cmsg_data[:12])
                return pid, uid, gid
    return None, None, None


def parse_timestamp(data: bytes) -> Optional[float]:
    """Parse heartbeat timestamp string or binary float, enforcing finite and non-negative values."""
    ts = None
    if len(data) == 8:
        try:
            ts = struct.unpack("d", data)[0]
        except Exception:
            ts = None
    if ts is None:
        try:
            s = data.decode("utf-8").strip()
            ts = float(s)
        except Exception:
            return None
    if ts is not None and math.isfinite(ts) and ts >= 0.0:
        return ts
    return None


def validate_heartbeat(
    msg: bytes,
    ancdata,
    sender_name: str,
    expected_pid: Optional[int],
    expected_uid: int,
    now_mono: float,
    last_accepted_ts: Optional[float],
    deadline_sec: float,
) -> Tuple[bool, Optional[float], str]:
    """
    Strict credential and monotonic freshness validation for supervisor heartbeats.
    Enforces expected UID and PID, non-finite rejection, and monotonic freshness.
    """
    pid, uid, _ = extract_credentials(ancdata)
    if uid is None:
        return False, None, f"Credential rejection: missing peer UID for {sender_name}"
    if uid != expected_uid:
        return (
            False,
            None,
            f"Credential rejection: UID {uid} does not match expected {expected_uid}",
        )

    if expected_pid is not None:
        if pid is None or pid != expected_pid:
            return (
                False,
                None,
                f"Credential rejection: PID {pid} does not match expected {expected_pid}",
            )
    elif pid is None:
        return False, None, f"Credential rejection: missing peer PID for {sender_name}"

    ts = parse_timestamp(msg)
    if ts is None:
        return (
            False,
            None,
            f"Payload rejection: non-finite, negative, or malformed timestamp for {sender_name}",
        )

    # Future timestamp check (small tolerance for process scheduling)
    if ts > now_mono + 1.0:
        return (
            False,
            None,
            f"Freshness rejection: timestamp {ts:.3f} is in the future relative to {now_mono:.3f}",
        )

    # Stale timestamp check
    age = now_mono - ts
    if age > deadline_sec:
        return (
            False,
            None,
            f"Freshness rejection: heartbeat age {age:.3f}s exceeds deadline {deadline_sec:.3f}s",
        )

    # Monotonic order check
    if last_accepted_ts is not None and ts < last_accepted_ts:
        return (
            False,
            None,
            f"Freshness rejection: timestamp {ts:.3f} is older than last accepted {last_accepted_ts:.3f}",
        )

    return True, ts, f"Accepted heartbeat for {sender_name}"


def send_systemd_notify(message: str, notify_sock_path: Optional[str] = None):
    """Send sd_notify datagram to systemd."""
    sock_path = notify_sock_path or os.environ.get("NOTIFY_SOCKET")
    if not sock_path:
        return
    try:
        if sock_path.startswith("@"):
            sock_path = "\0" + sock_path[1:]
        s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        s.connect(sock_path)
        s.sendall(message.encode("utf-8"))
        s.close()
    except Exception as e:
        sys.stderr.write(
            f"[mentorpi-tank-run] Failed to send systemd notification '{message}': {e}\n"
        )


def verify_runtime_paths(current_dir: str) -> bool:
    """Verify that current release and configuration files exist."""
    install_dir = os.path.join(current_dir, "install")
    if not os.path.isdir(install_dir):
        sys.stderr.write(f"ERROR: Install directory missing: {install_dir}\n")
        return False
    setup_file = os.path.join(install_dir, "setup.bash")
    if not os.path.isfile(setup_file):
        sys.stderr.write(f"ERROR: setup.bash missing in install tree: {setup_file}\n")
        return False
    fastdds_prof = os.path.join(current_dir, "config", "fastdds", "loopback.xml")
    if not os.path.isfile(fastdds_prof):
        sys.stderr.write(f"ERROR: Fast DDS loopback profile missing: {fastdds_prof}\n")
        return False
    if validate_loopback_profile is not None:
        ok, errs = validate_loopback_profile(fastdds_prof)
        if not ok:
            sys.stderr.write(
                f"ERROR: Fast DDS loopback profile invalid:\n"
                + "\n".join(f"  - {e}" for e in errs)
                + "\n"
            )
            return False
    return True


def load_and_validate_host_config(
    config_path: str,
) -> Tuple[Optional[Dict[str, Any]], List[str]]:
    """Load and validate host controller configuration."""
    if not os.path.isfile(config_path):
        return None, [f"Configuration file does not exist: '{config_path}'"]

    try:
        with open(config_path, "r", encoding="utf-8") as f:
            cfg = yaml.safe_load(f)
    except Exception as e:
        return None, [f"Failed to parse YAML configuration: {e}"]

    if validate_config is not None:
        ok, errs = validate_config(cfg)
        if not ok:
            return None, errs

    return cfg, []


def build_launch_arguments(cfg: Optional[Dict[str, Any]]) -> List[str]:
    """Convert controller.yaml configuration into ros2 launch arguments."""
    args = ["controller_only:=true", "localhost_only:=1"]
    if not cfg:
        return args

    ctrl = cfg.get("controller", {})
    for limit in ("max_linear_speed", "max_angular_speed"):
        if limit in ctrl:
            args.append(f"{limit}:={ctrl[limit]}")
    if "machine_type" in ctrl:
        args.append(f"machine_type:={ctrl['machine_type']}")
    if "wheelbase" in ctrl:
        args.append(f"wheelbase:={ctrl['wheelbase']}")
    if "track_width" in ctrl:
        args.append(f"track_width:={ctrl['track_width']}")
    if "wheel_diameter" in ctrl:
        args.append(f"wheel_diameter:={ctrl['wheel_diameter']}")

    corr = ctrl.get("correction_factor", {})
    if "left" in corr:
        args.append(f"left_correction_factor:={corr['left']}")
    if "right" in corr:
        args.append(f"right_correction_factor:={corr['right']}")
    if "linear" in corr:
        args.append(f"linear_correction_factor:={corr['linear']}")
    if "angular" in corr:
        args.append(f"angular_correction_factor:={corr['angular']}")

    mg = cfg.get("motor_guard", {})
    if "max_rps" in mg:
        args.append(f"max_rps:={mg['max_rps']}")
    if "timeout_sec" in mg:
        args.append(f"guard_timeout_sec:={mg['timeout_sec']}")
    if "check_rate_hz" in mg:
        args.append(f"check_rate_hz:={mg['check_rate_hz']}")
    if "heartbeat_interval_sec" in mg:
        args.append(f"guard_heartbeat_interval_sec:={mg['heartbeat_interval_sec']}")

    sb = cfg.get("serial_bridge", {})
    if "serial_device" in sb:
        args.append(f"serial_device:={sb['serial_device']}")
    if "baud_rate" in sb:
        args.append(f"baud_rate:={sb['baud_rate']}")
    if "serial_read_timeout_sec" in sb:
        args.append(f"serial_read_timeout_sec:={sb['serial_read_timeout_sec']}")
    if "write_timeout_sec" in sb:
        args.append(f"write_timeout_sec:={sb['write_timeout_sec']}")
    if "freshness_timeout_sec" in sb:
        args.append(f"freshness_timeout_sec:={sb['freshness_timeout_sec']}")
    if "serial_silence_timeout_sec" in sb:
        args.append(f"serial_silence_timeout_sec:={sb['serial_silence_timeout_sec']}")

    # Enforce write_timeout_sec < freshness_timeout_sec invariant
    if "write_timeout_sec" in sb or "freshness_timeout_sec" in sb:
        wt = float(sb.get("write_timeout_sec", 0.100))
        ft = float(sb.get("freshness_timeout_sec", 0.250))
        if wt >= ft:
            raise ValueError(
                f"serial_bridge.write_timeout_sec ({wt}s) must be strictly less than "
                f"serial_bridge.freshness_timeout_sec ({ft}s)"
            )

    return args


def main():
    parser = argparse.ArgumentParser(
        description="MentorPi Tank Native Controller Service Runner"
    )
    parser.add_argument(
        "--check",
        "--verify",
        action="store_true",
        help="Verify installed tree and environment without running",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Simulate launch and supervisor without mutating system",
    )
    args = parser.parse_args()

    # Determine release root directory
    bin_dir = os.path.abspath(os.path.dirname(__file__))
    current_dir = os.path.abspath(os.path.join(bin_dir, ".."))

    # 0. Preflight check: coordinate startup with deployment lock and require clean journal
    lock_path = os.environ.get(
        "UBUNTU_TANK_LOCK_FILE", "/run/lock/ubuntu_tank/deploy.lock"
    )
    journal_path = os.environ.get(
        "UBUNTU_TANK_JOURNAL_FILE", "/var/opt/ubuntu_tank/deployment/activation-journal"
    )

    # Acquire shared deployment coordination lock for startup transition
    startup_lock_fd = None
    if os.path.exists(lock_path) or os.path.isdir(os.path.dirname(lock_path)):
        try:
            try:
                startup_lock_fd = os.open(lock_path, os.O_RDWR)
            except (PermissionError, OSError):
                startup_lock_fd = os.open(lock_path, os.O_RDONLY)
        except Exception as e:
            sys.stderr.write(
                f"[mentorpi-tank-run] FATAL: Cannot open deployment lock at '{lock_path}': {e}. Failing closed.\n"
            )
            sys.stderr.flush()
            sys.exit(1)

        if startup_lock_fd is not None:
            try:
                fcntl.flock(startup_lock_fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
            except (IOError, OSError):
                sys.stderr.write(
                    f"[mentorpi-tank-run] FATAL: Deployment lock at '{lock_path}' is held by another process. "
                    "Cannot start controller during deployment.\n"
                )
                sys.stderr.flush()
                try:
                    os.close(startup_lock_fd)
                except Exception:
                    pass
                sys.exit(1)

    def release_startup_lock():
        nonlocal startup_lock_fd
        if startup_lock_fd is not None:
            try:
                fcntl.flock(startup_lock_fd, fcntl.LOCK_UN)
                os.close(startup_lock_fd)
            except Exception:
                pass
            startup_lock_fd = None

    # Activation journal validation: fail closed on corruption, unreadability, or uncommitted transaction
    dep_dir = os.path.dirname(journal_path)
    if os.path.exists(journal_path):
        try:
            with open(journal_path, "r", encoding="utf-8") as f:
                jdata = json.load(f)
            if not isinstance(jdata, dict) or "format_version" not in jdata:
                sys.stderr.write(
                    f"[mentorpi-tank-run] FATAL: Activation journal at '{journal_path}' has invalid schema. "
                    "Failing closed.\n"
                )
                sys.stderr.flush()
                release_startup_lock()
                sys.exit(1)
            tx = jdata.get("current_transaction")
            if tx is not None:
                sys.stderr.write(
                    f"[mentorpi-tank-run] FATAL: Uncommitted activation transaction '{tx.get('tx_id')}' "
                    f"in state '{tx.get('status')}'. Refusing to start controller before clean recovery.\n"
                )
                sys.stderr.flush()
                release_startup_lock()
                sys.exit(1)
        except Exception as e:
            sys.stderr.write(
                f"[mentorpi-tank-run] FATAL: Failed to read activation journal at '{journal_path}': {e}. "
                "Failing closed.\n"
            )
            sys.stderr.flush()
            release_startup_lock()
            sys.exit(1)
    elif os.path.exists(dep_dir) or os.path.islink(
        os.path.join(os.path.dirname(current_dir), "current")
    ):
        sys.stderr.write(
            f"[mentorpi-tank-run] FATAL: Activation journal missing at '{journal_path}'. "
            "Cannot start controller without verified activation state. Failing closed.\n"
        )
        sys.stderr.flush()
        release_startup_lock()
        sys.exit(1)

    # 1. Load host environment file
    env_file = os.environ.get(
        "UBUNTU_TANK_ENV_FILE", "/etc/opt/ubuntu_tank/mentorpi-tank.env"
    )
    host_env = parse_env_file(env_file)
    for k, v in host_env.items():
        if k not in os.environ:
            os.environ[k] = v

    # 2. Source ROS 2 Lyrical and release install environments
    lyrical_setup = os.environ.get("ROS_SETUP", "/opt/ros/lyrical/setup.bash")
    release_setup = os.path.join(current_dir, "install", "setup.bash")
    sourced_env = source_bash_environment([lyrical_setup, release_setup])
    for k, v in sourced_env.items():
        os.environ[k] = v

    # 3. Enforce security, isolation, and Fast DDS loopback discovery invariants
    if apply_loopback_env is not None:
        try:
            apply_loopback_env(base_dir=current_dir)
        except Exception as exc:
            sys.stderr.write(
                f"[mentorpi-tank-run] FATAL: Fast DDS loopback discovery setup failed: {exc}\n"
            )
            sys.stderr.flush()
            release_startup_lock()
            sys.exit(1)
    else:
        prof = os.path.join(current_dir, "config", "fastdds", "loopback.xml")
        if not os.path.isfile(prof):
            sys.stderr.write(
                f"[mentorpi-tank-run] FATAL: Fast DDS loopback profile missing at '{prof}'. Failing closed.\n"
            )
            sys.stderr.flush()
            release_startup_lock()
            sys.exit(1)
        os.environ["RMW_IMPLEMENTATION"] = "rmw_fastrtps_cpp"
        os.environ["ROS_DOMAIN_ID"] = "0"
        os.environ["ROS_LOCALHOST_ONLY"] = "1"
        os.environ["ROS_AUTOMATIC_DISCOVERY_RANGE"] = "SYSTEM_DEFAULT"
        os.environ["FASTDDS_DEFAULT_PROFILES_FILE"] = prof
        os.environ["ROS_SECURITY_ENABLE"] = "true"
        os.environ["ROS_SECURITY_STRATEGY"] = "Enforce"

    log_dir = os.environ.get("ROS_LOG_DIR", "/var/opt/ubuntu_tank/ros-log")
    os.environ["ROS_LOG_DIR"] = log_dir
    try:
        os.makedirs(log_dir, exist_ok=True)
    except Exception:
        pass

    # 4. Load, validate, and apply host controller safety configuration
    default_config = "/etc/opt/ubuntu_tank/controller.yaml"
    fallback_config = os.path.join(current_dir, "config", "controller.yaml")
    if "UBUNTU_TANK_CONFIG" in os.environ:
        config_path = os.environ["UBUNTU_TANK_CONFIG"]
    elif os.path.isfile(default_config):
        config_path = default_config
    elif os.path.isfile(fallback_config):
        config_path = fallback_config
    else:
        config_path = default_config

    cfg, cfg_errors = load_and_validate_host_config(config_path)
    if cfg_errors:
        sys.stderr.write(
            f"[mentorpi-tank-run] FATAL: Host configuration at '{config_path}' failed validation:\n"
            + "\n".join(f"  - {e}" for e in cfg_errors)
            + "\n"
        )
        sys.stderr.flush()
        release_startup_lock()
        sys.exit(1)

    # 5. Verify hardware mutual exclusion before proceeding
    if check_hardware_mutual_exclusion:
        serial_dev = (cfg or {}).get("serial_bridge", {}).get("serial_device")
        ok, exc_errors = check_hardware_mutual_exclusion(serial_dev=serial_dev)
        if not ok:
            sys.stderr.write(
                "[mentorpi-tank-run] FATAL: Hardware mutual exclusion check failed:\n"
                + "\n".join(f"  - {e}" for e in exc_errors)
                + "\n"
            )
            sys.stderr.flush()
            release_startup_lock()
            sys.exit(1)

    launch_args = build_launch_arguments(cfg)

    # Supervisor configuration from controller.yaml
    sv_cfg = (cfg or {}).get("supervisor", {})
    guard_deadline = float(
        sv_cfg.get(
            "guard_deadline_sec", os.environ.get("UBUNTU_TANK_GUARD_DEADLINE", "1.0")
        )
    )
    bridge_deadline = float(
        sv_cfg.get(
            "bridge_deadline_sec", os.environ.get("UBUNTU_TANK_BRIDGE_DEADLINE", "1.0")
        )
    )
    check_interval = float(sv_cfg.get("check_interval_sec", "0.200"))

    expected_uid = os.geteuid()
    expected_guard_pid_str = os.environ.get("UBUNTU_TANK_GUARD_PID")
    expected_bridge_pid_str = os.environ.get("UBUNTU_TANK_BRIDGE_PID")
    guard_pid_file = os.environ.get(
        "UBUNTU_TANK_GUARD_PID_FILE", "/run/ubuntu_tank/guard.pid"
    )
    bridge_pid_file = os.environ.get(
        "UBUNTU_TANK_BRIDGE_PID_FILE", "/run/ubuntu_tank/bridge.pid"
    )

    expected_guard_pid = (
        int(expected_guard_pid_str)
        if expected_guard_pid_str and expected_guard_pid_str.isdigit()
        else None
    )
    expected_bridge_pid = (
        int(expected_bridge_pid_str)
        if expected_bridge_pid_str and expected_bridge_pid_str.isdigit()
        else None
    )

    if args.check:
        release_startup_lock()
        if verify_runtime_paths(current_dir):
            print(
                f"[mentorpi-tank-run] Release runtime paths and configuration verified at {current_dir}"
            )
            sys.exit(0)
        else:
            sys.exit(1)

    guard_sock_path = os.environ.get(
        "UBUNTU_TANK_GUARD_SOCK", "/run/ubuntu_tank/guard_heartbeat.sock"
    )
    bridge_sock_path = os.environ.get(
        "UBUNTU_TANK_BRIDGE_SOCK", "/run/ubuntu_tank/bridge_heartbeat.sock"
    )

    if args.dry_run:
        release_startup_lock()
        print(
            "[mentorpi-tank-run:dry-run] Host environment and launch parameters verified."
        )
        print(f"[mentorpi-tank-run:dry-run] Release directory: {current_dir}")
        print(f"[mentorpi-tank-run:dry-run] Configuration file: {config_path}")
        print(f"[mentorpi-tank-run:dry-run] Launch arguments: {' '.join(launch_args)}")
        print(
            f"[mentorpi-tank-run:dry-run] Guard socket: {guard_sock_path} (deadline={guard_deadline}s)"
        )
        print(
            f"[mentorpi-tank-run:dry-run] Bridge socket: {bridge_sock_path} (deadline={bridge_deadline}s)"
        )
        sys.exit(0)

    # Clean up stale sockets
    for p in [guard_sock_path, bridge_sock_path]:
        try:
            if os.path.exists(p):
                os.unlink(p)
        except Exception:
            pass

    # Create socket directory if needed
    for p in [guard_sock_path, bridge_sock_path]:
        try:
            os.makedirs(os.path.dirname(p), exist_ok=True)
        except Exception:
            pass

    # Bind heartbeat sockets with SO_PASSCRED
    guard_sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    guard_sock.bind(guard_sock_path)
    guard_sock.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)
    os.chmod(guard_sock_path, 0o660)

    bridge_sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    bridge_sock.bind(bridge_sock_path)
    bridge_sock.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)
    os.chmod(bridge_sock_path, 0o660)

    # Launch ROS bringup graph as a supervised child process
    override_child = os.environ.get("_UBUNTU_TANK_TEST_CHILD_CMD")
    if override_child:
        import shlex

        launch_cmd = shlex.split(override_child)
    else:
        launch_cmd = [
            "ros2",
            "launch",
            "ubuntu_tank_bringup",
            "tank.launch.py",
        ] + launch_args
    sys.stdout.write(
        f"[mentorpi-tank-run] Launching ROS graph: {' '.join(launch_cmd)}\n"
    )
    sys.stdout.flush()

    child = subprocess.Popen(
        launch_cmd, env=os.environ.copy(), stdout=sys.stdout, stderr=sys.stderr
    )

    # Startup transition complete: release deployment coordination lock
    release_startup_lock()

    running = True
    shutdown_requested = False
    child_exit_code: Optional[int] = None

    def handle_signal(sig, frame):
        nonlocal running, shutdown_requested
        sys.stdout.write(
            f"[mentorpi-tank-run] Received shutdown signal {sig}, terminating gracefully...\n"
        )
        sys.stdout.flush()
        shutdown_requested = True
        running = False

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    # Supervisor state
    guard_last: Optional[float] = None
    guard_last_ts: Optional[float] = None
    bridge_last: Optional[float] = None
    bridge_last_ts: Optional[float] = None
    last_watchdog_ping = time.monotonic()
    ready_notified = False

    poll_descriptors = [guard_sock, bridge_sock]

    try:
        while running:
            # Check if ROS launch child is still alive
            ret = child.poll()
            if ret is not None:
                child_exit_code = ret
                sys.stderr.write(
                    f"[mentorpi-tank-run] ROS bringup child process exited with code {ret}.\n"
                )
                break

            rlist, _, _ = select.select(poll_descriptors, [], [], check_interval)
            now = time.monotonic()

            for desc in rlist:
                if desc is guard_sock:
                    try:
                        msg, ancdata, _, _ = guard_sock.recvmsg(256, 256)
                        if expected_guard_pid is None and os.path.isfile(
                            guard_pid_file
                        ):
                            try:
                                with open(guard_pid_file, "r", encoding="utf-8") as pf:
                                    c = pf.read().strip()
                                    if c.isdigit():
                                        expected_guard_pid = int(c)
                            except Exception:
                                pass
                        ok, ts, reason = validate_heartbeat(
                            msg=msg,
                            ancdata=ancdata,
                            sender_name="guard",
                            expected_pid=expected_guard_pid,
                            expected_uid=expected_uid,
                            now_mono=now,
                            last_accepted_ts=guard_last_ts,
                            deadline_sec=guard_deadline,
                        )
                        if ok and ts is not None:
                            guard_last = now
                            guard_last_ts = ts
                        else:
                            sys.stderr.write(
                                f"[mentorpi-tank-run] Warning: guard datagram rejected: {reason}\n"
                            )
                            sys.stderr.flush()
                    except Exception as e:
                        sys.stderr.write(
                            f"[mentorpi-tank-run] Error receiving guard heartbeat: {e}\n"
                        )
                elif desc is bridge_sock:
                    try:
                        msg, ancdata, _, _ = bridge_sock.recvmsg(256, 256)
                        if expected_bridge_pid is None and os.path.isfile(
                            bridge_pid_file
                        ):
                            try:
                                with open(bridge_pid_file, "r", encoding="utf-8") as pf:
                                    c = pf.read().strip()
                                    if c.isdigit():
                                        expected_bridge_pid = int(c)
                            except Exception:
                                pass
                        ok, ts, reason = validate_heartbeat(
                            msg=msg,
                            ancdata=ancdata,
                            sender_name="bridge",
                            expected_pid=expected_bridge_pid,
                            expected_uid=expected_uid,
                            now_mono=now,
                            last_accepted_ts=bridge_last_ts,
                            deadline_sec=bridge_deadline,
                        )
                        if ok and ts is not None:
                            bridge_last = now
                            bridge_last_ts = ts
                        else:
                            sys.stderr.write(
                                f"[mentorpi-tank-run] Warning: bridge datagram rejected: {reason}\n"
                            )
                            sys.stderr.flush()
                    except Exception as e:
                        sys.stderr.write(
                            f"[mentorpi-tank-run] Error receiving bridge heartbeat: {e}\n"
                        )

            # Evaluate AND-gated health periodically
            if now - last_watchdog_ping >= check_interval:
                last_watchdog_ping = now
                guard_ok = (guard_last is not None) and (
                    (now - guard_last) <= guard_deadline
                )
                bridge_ok = (bridge_last is not None) and (
                    (now - bridge_last) <= bridge_deadline
                )
                if guard_ok and bridge_ok:
                    if not ready_notified:
                        ready_notified = True
                        send_systemd_notify("READY=1")
                        sys.stdout.write(
                            "[mentorpi-tank-run] Guard and bridge healthy. Systemd notified READY=1.\n"
                        )
                        sys.stdout.flush()
                    send_systemd_notify("WATCHDOG=1")
                elif ready_notified:
                    reasons = []
                    if not guard_ok:
                        reasons.append(f"guard timeout (last={guard_last})")
                    if not bridge_ok:
                        reasons.append(f"bridge timeout (last={bridge_last})")
                    sys.stderr.write(
                        f"[mentorpi-tank-run] Watchdog ping withheld: {', '.join(reasons)}\n"
                    )
                    sys.stderr.flush()

    finally:
        # Graceful shutdown: send SIGINT to child so motor_guard sends 5 zero commands
        if child.poll() is None:
            sys.stdout.write(
                "[mentorpi-tank-run] Sending SIGINT to ROS child process for safe zeroing...\n"
            )
            sys.stdout.flush()
            child.send_signal(signal.SIGINT)
            try:
                child.wait(timeout=3.5)
            except subprocess.TimeoutExpired:
                sys.stderr.write(
                    "[mentorpi-tank-run] Warning: Child did not exit after SIGINT, sending SIGKILL.\n"
                )
                child.kill()
                child.wait()

        # Clean up sockets
        for sock, path in [
            (guard_sock, guard_sock_path),
            (bridge_sock, bridge_sock_path),
        ]:
            try:
                sock.close()
                if os.path.exists(path):
                    os.unlink(path)
            except Exception:
                pass

        send_systemd_notify("STOPPING=1")
        sys.stdout.write("[mentorpi-tank-run] Shutdown complete.\n")
        sys.stdout.flush()

    # Propagate unexpected child termination as supervisor failure
    if not shutdown_requested:
        sys.stderr.write(
            f"[mentorpi-tank-run] FATAL: ROS bringup child process terminated unexpectedly "
            f"with code {child_exit_code}.\n"
        )
        sys.stderr.flush()
        if child_exit_code is not None and child_exit_code != 0:
            sys.exit(child_exit_code)
        else:
            # Unexpected zero termination is still a service failure
            sys.exit(1)

    sys.exit(0)


if __name__ == "__main__":
    main()
