<?xml version="1.0" encoding="utf-8"?>
<!--
DDS Security permissions XML for read-only status monitor enclave
-->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="http://www.omg.org/spec/DDS-SECURITY/20170901/omg_shared_ca_permissions.xsd">
  <permissions>
    <grant name="/ubuntu_tank/status">
      <subject_name>CN=/ubuntu_tank/status</subject_name>
      <validity>
        <not_before>2026-01-01T00:00:00</not_before>
        <not_after>2036-01-01T00:00:00</not_after>
      </validity>
      <allow_rule>
        <domains>
          <id>0</id>
        </domains>
        <publish>
          <topics>
            <topic>ros_discovery_info</topic>
            <topic>rt/rosout</topic>
            <topic>rt/parameter_events</topic>
            <topic>rr/status_client/*Reply</topic>
            <topic>rr/_ros2cli_direct*/*Reply</topic>
          </topics>
        </publish>
        <subscribe>
          <topics>
            <topic>ros_discovery_info</topic>
            <topic>rt/ubuntu_tank_safety/state</topic>
            <topic>rt/ubuntu_tank_safety/armed</topic>
            <topic>rt/ros_robot_controller/battery</topic>
            <topic>rt/odom_raw</topic>
            <topic>rt/ubuntu_tank/delivery_observation</topic>
            <topic>rt/parameter_events</topic>
            <topic>rq/status_client/*Request</topic>
            <topic>rq/_ros2cli_direct*/*Request</topic>
          </topics>
        </subscribe>
      </allow_rule>
      <default>DENY</default>
    </grant>
  </permissions>
</dds>
