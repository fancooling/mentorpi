# Systemd lifecycle group for the complete MentorPi native control stack.
# Keeps the hardware controller and operator authority as independently
# sandboxed services while providing one administrative start/stop unit.
[Unit]
Description=MentorPi Tank Complete Control Stack
Wants=mentorpi-tank.service mentorpi-tank-operator.service
After=mentorpi-tank.service

[Install]
WantedBy=multi-user.target
