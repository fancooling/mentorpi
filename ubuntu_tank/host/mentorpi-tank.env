# MentorPi Tank Native Runtime Environment
# Pinned non-secret host environment loaded by systemd

ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=1
ROS_SECURITY_ENABLE=true
ROS_SECURITY_STRATEGY=Enforce
ROS_SECURITY_KEYSTORE=/etc/opt/ubuntu_tank/security/keystore
ROS_LOG_DIR=/var/opt/ubuntu_tank/ros-log
UBUNTU_TANK_CONFIG=/etc/opt/ubuntu_tank/controller.yaml
UBUNTU_TANK_GUARD_SOCK=/run/ubuntu_tank/guard_heartbeat.sock
UBUNTU_TANK_BRIDGE_SOCK=/run/ubuntu_tank/bridge_heartbeat.sock
