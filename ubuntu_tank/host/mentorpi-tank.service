# Hardened native systemd service unit template with Type=notify and sandboxing
[Unit]
Description=MentorPi Tank Native Motion Controller
After=network.target mentorpi-tank-recover.service
Wants=network.target
Requires=mentorpi-tank-recover.service
PartOf=mentorpi-tank-stack.target
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=ubuntu-tank
Group=mentorpi-rrc
WorkingDirectory=/opt/ubuntu_tank/current
EnvironmentFile=/etc/opt/ubuntu_tank/mentorpi-tank.env
ExecStart=/opt/ubuntu_tank/current/bin/mentorpi-tank-run
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
WatchdogSec=2s

# Hardened sandboxing constraints
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0002
IPAddressDeny=any
IPAddressAllow=localhost
DeviceAllow=/dev/rrc rw
DevicePolicy=closed
ReadWritePaths=/var/opt/ubuntu_tank /run/ubuntu_tank
ReadOnlyPaths=/opt/ubuntu_tank /etc/opt/ubuntu_tank

[Install]
WantedBy=multi-user.target
